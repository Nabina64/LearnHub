# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the real ".env" file to version control.

# --- Application ---
# "production" hides PHP/DB errors from visitors and logs them instead.
# "development" shows errors on screen - use only on your own machine.
APP_ENV=production

# Set to 1 once the site is served over HTTPS in production.
# This forces every request to redirect to https:// and marks the
# session cookie "secure" (browsers will not send it over plain http).
FORCE_HTTPS=0

# Full base URL of the site, no trailing slash. Used to build the
# links inside emails (password reset, email verification), which
# must always be absolute. If left blank, it is guessed from the
# current request - fine for local development, but set this
# explicitly in production.
APP_URL=http://localhost/online-learning-platform

# --- Database ---
DB_HOST=localhost
DB_NAME=online_learning
DB_USER=root
DB_PASS=

# --- Outgoing email (Contact page) ---
# Gmail requires an "App Password", not your normal password -
# turn on 2-Step Verification on the Gmail account first, then
# create one here: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM_NAME=LearnHub
